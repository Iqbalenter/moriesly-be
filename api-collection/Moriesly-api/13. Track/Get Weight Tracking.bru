meta {
  name: Get Weight Tracking
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/track/weight?limit=30
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

params:query {
  limit: 30
}

docs {
  ## Get Weight Tracking
  
  Mendapatkan weight history dengan tracking data untuk chart/timeline.
}
