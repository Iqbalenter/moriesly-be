# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ─── Frontend URL (CORS) ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:4000
ALLOWED_ORIGINS=
# Untuk multiple origin, pisahkan dengan koma:
# FRONTEND_URLS=https://moriesly.com,https://www.moriesly.com,http://localhost:3000

# ─── Firebase Client Auth (untuk admin login/register/refresh) ───────────────
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# Secret optional untuk endpoint POST /api/admin/register
# Jika dikosongkan, register admin tetap terbuka (tidak direkomendasikan untuk production)
ADMIN_REGISTER_SECRET=your_admin_register_secret

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# Path ke file service account JSON, atau set sebagai JSON string
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-admin.json

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── SMTP – Email Service (Waitlist Ticket & Notifikasi) ─────────────────────
#
# Pilihan A: Gmail
#   1. Aktifkan "2-Step Verification" di akun Google kamu
#   2. Buat "App Password" di https://myaccount.google.com/apppasswords
#   3. Gunakan App Password sebagai SMTP_PASS (BUKAN password Google biasa)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM_NAME=Moriesly Team
SMTP_FROM_EMAIL=your_email@gmail.com

#
# Pilihan B: Resend (https://resend.com) — direkomendasikan untuk production
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx   ← API Key dari Resend dashboard
#   SMTP_FROM_NAME=Moriesly Team
#   SMTP_FROM_EMAIL=noreply@moriesly.com
#
# Pilihan C: Brevo / Sendinblue
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your_brevo_login_email
#   SMTP_PASS=your_brevo_smtp_key
#   SMTP_FROM_NAME=Moriesly Team
#   SMTP_FROM_EMAIL=noreply@moriesly.com
#
# Pilihan D: Mailgun
#   SMTP_HOST=smtp.mailgun.org
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=postmaster@mg.moriesly.com
#   SMTP_PASS=your_mailgun_smtp_password
#   SMTP_FROM_NAME=Moriesly Team
#   SMTP_FROM_EMAIL=noreply@moriesly.com
